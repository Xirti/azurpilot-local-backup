{
  "schema_version": 1,
  "purpose": "只备份运行、恢复与维护所需目标；排除项不得进入任何已推送提交",
  "tracked_directories": ["assets", "bin", "campaign", "deploy", "doc", "docs", "licenses", "module", "submodule"],
  "root_files": [".gitattributes", ".gitignore", "AGENTS.md", "CLAUDE.md", "LICENSE", "README.md", "README_UPSTREAM.md", "README.en.md", "README.ja.md", "README.ko.md", "README.zh-TW.md", "alas.py", "gui.py", "tui.py", "mcp_server_sse.py", "pyproject.toml", "uv.lock", "启动WebUI_无限等待.cmd", "关闭WebUI.cmd", "start-webui-no-timeout.ps1", "stop-webui.ps1", "备份本机配置.cmd", "恢复本地设置.cmd", "检查本地设置.cmd", "手动重建前端.ps1", "手动重建运行环境.ps1", "初始化离线包.cmd", "initialize-offline-release.ps1"],
  "frontend_directories": ["frontend/src", "frontend/public", "frontend/dist"],
  "frontend_files": ["frontend/package.json", "frontend/package-lock.json", "frontend/index.html", "frontend/vite.config.ts", "frontend/tsconfig.json", "frontend/API.md", "frontend/README.md"],
  "maintenance_directories": ["local-maintenance", "local-repairs"],
  "configuration_allowlist": ["config/template*.json", "config/deploy.template*.yaml", "config/webui_bg.css"],
  "excluded_components": ["test", "tests", "__tests__", "mock", "e2e", "fixtures", "__pycache__", "node_modules", ".venv", "cache", "log", "screenshots", "python-runtime", "private", "offline-artifacts"],
  "excluded_file_patterns": ["test_*.py", "*_test.py", "conftest.py", "*.test.*", "*.spec.*", "playwright*.config.*", "vitest.config.*", "*.pyc", "*.pem", "*.key", "*.bak"],
  "excluded_maintenance_files": ["local-maintenance/runtime.json", "local-maintenance/validation-private.json"],
  "note": "生产页面中实际导入的预览组件及其生产chunk属于运行产物；测试目录、mock服务器与检查脚本不属于运行产物。私人配置、数据库、日志、运行环境和临时验证工具另存本机。"
}
